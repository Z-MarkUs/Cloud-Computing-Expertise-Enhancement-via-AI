# Safe local defaults. Copy this file to .env; .env is ignored by Git.
CLOUD_TUTOR_ENVIRONMENT=development
CLOUD_TUTOR_MODE=demo
CLOUD_TUTOR_LOG_LEVEL=INFO
CLOUD_TUTOR_HOST=0.0.0.0
CLOUD_TUTOR_PORT=8000
CLOUD_TUTOR_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Optional request authentication. Use a long random value when enabling it.
# CLOUD_TUTOR_API_KEY=replace-with-a-secret

# Azure mode requires the five non-secret settings below. The default provider
# uses Azure CLI credentials locally and managed identity in Azure Container Apps.
# CLOUD_TUTOR_MODE=azure
# CLOUD_TUTOR_AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/
# CLOUD_TUTOR_AZURE_CHAT_DEPLOYMENT=your-chat-deployment
# CLOUD_TUTOR_AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment
# CLOUD_TUTOR_AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# CLOUD_TUTOR_AZURE_SEARCH_INDEX=your-index
# CLOUD_TUTOR_AZURE_SEARCH_SEMANTIC_CONFIGURATION=your-semantic-configuration

# Key authentication is supported only as a fallback. Never commit real keys.
# CLOUD_TUTOR_AZURE_OPENAI_API_KEY=replace-with-a-secret
# CLOUD_TUTOR_AZURE_SEARCH_API_KEY=replace-with-a-secret
